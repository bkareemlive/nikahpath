# Supabase — from your project's Settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the browser. Used for admin scripts / webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the app is served (used for auth email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (payments) ---------------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys  (use test keys first)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint's signing secret in prod
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ids — create with `node scripts/stripe-setup.mjs` (prints these)
STRIPE_PRICE_FULL_MONTHLY=price_xxx
STRIPE_PRICE_FULL_6MO=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx
# Launch-promo prices (only used while promo.active in src/data/pricing.ts)
STRIPE_PRICE_FULL_MONTHLY_PROMO=price_xxx
STRIPE_PRICE_FULL_6MO_PROMO=price_xxx
STRIPE_PRICE_LIFETIME_PROMO=price_xxx
